# The model that runs investigations. Copy this file to .env and fill it in.
# Any model served in the OpenAI format works. Left empty, Retrace uses a local
# Ollama model, which needs no key but is much less accurate.

# The address of the model service, ending before /chat/completions.
LLM_BASE_URL=
# The model's name, as the service spells it.
LLM_MODEL=
# Your key. Never commit the .env file.
LLM_API_KEY=
# Only if the service wants the key in a named header instead of as a bearer token,
# for example x-goog-api-key for Vertex AI.
LLM_API_KEY_HEADER=
# Optional: the model's price in US dollars per million tokens, to show what each
# investigation cost. Take them from your provider's price list.
LLM_PRICE_INPUT_PER_MILLION=
LLM_PRICE_OUTPUT_PER_MILLION=
# Optional: send a trace of the agent's own work to any OpenTelemetry tool, such as
# Jaeger or Langfuse. A full address ending in /v1/traces.
AGENT_TRACES_ENDPOINT=

# The system to investigate. Every line is optional: the agent uses what is connected.
# To reach a program running on this machine, write host.docker.internal, not localhost.

# Logs and traces are not set here: your project sends them to Retrace (see the README).

# Its Postgres database. Any login will do: Retrace only ever opens it read-only.
# Example: postgresql://user:password@host.docker.internal:5432/orders
TARGET_DATABASE_URL=
# The folder of its git repository on this machine, to show recent code changes.
TARGET_REPO=
# Addresses that return its current settings as JSON, each with a name.
# Example: {"orders-api": "http://host.docker.internal:8000/admin/flags"}
CONFIG_SOURCES=
# A test copy of its API, to reproduce failures on. Never production.
TARGET_API_URL=
# Each recipe waits on the web page for you to approve it before anything is sent.
# Set to false to let the agent carry out its recipes without asking.
REPRODUCTION_NEEDS_APPROVAL=
